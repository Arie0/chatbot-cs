    {
      "parameters": {
        "jsCode": "const pergunta = $('Edit Fields').first().json.Pergunta;\nconst linhas = $input.all();\n\nlet contexto = \"\";\nfor (const linha of linhas) {\n  contexto += `Categoria: ${linha.json.Categoria} | Pergunta: ${linha.json.Pergunta} | Resposta: ${linha.json.Resposta} || `;\n}\n\nconst body = {\n  model: \"llama-3.3-70b-versatile\",\n  temperature: 0.3,\n  max_tokens: 500,\n  messages: [\n    {\n      role: \"system\",\n      content: \"Você é assistente interno de Customer Success da Nola. Ao responder, sempre inicie com uma saudação cordial e empática. Responda APENAS com base no contexto abaixo. Se não encontrar nenhuma informação relacionada, responda EXATAMENTE assim: 'Olá! Fico feliz em ajudar. Ainda não tenho essa informação na nossa base de conhecimento, mas não se preocupe! Para resolver isso rapidamente, acione o time responsável abra um chamado interno. Vou registrar essa dúvida na base em breve.' Contexto: \" + contexto\n    },\n    {\n      role: \"user\",\n      content: pergunta\n    }\n  ]\n};\n\nreturn [{ json: { body } }];"
      },
